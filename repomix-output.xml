        room: 'SALA A',
        session: 'Ostre zespoły wieńcowe u chorych z cukrzycą',
        topic: 'Kardiologia Kliniczna • Przypadek 1',
        question: '58-letni pacjent z NSTEMI i cukrzycą typu 2.',
        questionSub: 'Jaki schemat farmakoterapii wdrożysz w pierwszej dobie?',
        options: [
          { key: 'A', text: 'Podwójna terapia przeciwpłytkowa + heparyna niefrakcjonowana', pct: 18 },
          { key: 'B', text: 'Monoterapia ASA + inhibitor P2Y12 nowej generacji', pct: 68 },
          { key: 'C', text: 'Wdrożenie statyny wysokiej intensywności i odroczenie DAPT', pct: 14 }
        ],
        qaList: [
          { id: 'q1', text: 'Czy u chorych z eGFR poniżej 30 modyfikujemy dawkę nasycającą leku?', votes: 14 },
          { id: 'q2', text: 'Jakie jest zalecane okno czasowe dla PCI w tej grupie chorych?', votes: 6 },
          { id: 'q3', text: 'Czy stosujemy osłonę inhibitorami pompy protonowej u każdego pacjenta?', votes: 3 }
        ]
      }
    };

    let activePin = '1040';
    let currentMode = 'vote';

    function initScreen() {
      const data = PIN_DATABASE[activePin];
      if (!data) return;

      document.getElementById('header-room-name').innerText = data.room;
      document.getElementById('header-session-name').innerText = data.session;
      document.getElementById('screen-pin-val').innerText = activePin;
      document.getElementById('screen-topic').innerText = data.topic;
      document.getElementById('screen-question').innerText = data.question;
      document.getElementById('screen-sub').innerText = data.questionSub;

      const joinUrl = window.location.origin + '/app.html';
      const qrContainer = document.getElementById('qrcode');
      qrContainer.innerHTML = '';
      new QRCode(qrContainer, {
        text: joinUrl,
        width: 140,
        height: 140,
        colorDark : "#0f172a",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.M
      });

      renderOptions(data.options);
      renderQAList(data.qaList);
    }

    function renderOptions(options) {
      const list = document.getElementById('screen-options-list');
      list.innerHTML = options.map(opt => `
        <div class="quiz-bar-card">
          <div class="quiz-bar-fill" style="width: ${opt.pct}%;"></div>
          <div class="quiz-bar-text">
            <span class="quiz-letter-badge">${opt.key}</span>
            <span>${opt.text}</span>
          </div>
          <div class="quiz-bar-percentage">${opt.pct}%</div>
        </div>
      `).join('');
    }

    function renderQAList(qaList) {
      const container = document.getElementById('screen-qa-list');
      container.innerHTML = qaList.map(q => `
        <div class="qa-screen-card">
          <div class="qa-screen-text">${q.text}</div>
          <div class="qa-screen-votes">▲ ${q.votes}</div>
        </div>
      `).join('');
    }

    function setScreenMode(mode) {
      currentMode = mode;
      const btnVote = document.getElementById('btn-show-vote');
      const btnQa = document.getElementById('btn-show-qa');
      const viewVote = document.getElementById('view-vote-container');
      const viewQa = document.getElementById('view-qa-container');

      if (mode === 'vote') {
        btnVote.classList.add('active');
        btnQa.classList.remove('active');
        viewVote.classList.remove('hidden');
        viewQa.classList.add('hidden');
      } else {
        btnQa.classList.add('active');
        btnVote.classList.remove('active');
        viewQa.classList.remove('hidden');
        viewVote.classList.add('hidden');
      }
    }

    window.addEventListener('DOMContentLoaded', initScreen);
  </script>
