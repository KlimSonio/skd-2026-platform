<file path="screen.html">
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SKD 2026 - Telebim Sali Wykładowej</title>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    }

    body {
      background: #090d16;
      color: #f8fafc;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* GÓRNY PASEK */
    .screen-header {
      height: 70px;
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      z-index: 10;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .brand-logo-img {
      height: 44px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .session-meta-tag {
      font-size: 13px;
      font-weight: 700;
      color: #94a3b8;
      border-left: 2px solid #334155;
      padding-left: 14px;
    }
    .session-meta-tag strong {
      color: #38bdf8;
    }

    .mode-switch-group {
      display: flex;
      gap: 8px;
      background: #1e293b;
      padding: 4px;
      border-radius: 8px;
    }

    .btn-mode {
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 12px;
      font-weight: 800;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-mode.active {
      background: #2563eb;
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.4);
    }

    /* GŁÓWNY UKŁAD 16:9 */
    .screen-body {
      flex: 1;
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 32px;
      padding: 24px 32px;
      min-height: 0;
    }

    /* LEWY PANEL (PIN + QR) */
    .join-sidebar {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 10px 30px -5px rgba(0,0,0,0.5);
    }

    .join-instruction-title {
      font-size: 15px;
      font-weight: 800;
      color: #f8fafc;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .join-instruction-sub {
      font-size: 12px;
      color: #94a3b8;
      margin-bottom: 18px;
    }

    .qr-container {
      background: #ffffff;
      padding: 12px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .pin-display-box {
      width: 100%;
      background: #1e293b;
      border: 1.5px dashed #38bdf8;
      border-radius: 12px;
      padding: 12px;
    }

    .pin-label {
      font-size: 11px;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 1px;
    }

    .pin-value {
      font-size: 44px;
      font-weight: 900;
      color: #38bdf8;
      font-family: monospace !important;
      letter-spacing: 6px;
      line-height: 1.1;
      margin-top: 2px;
    }

    /* PRAWY OBSZAR PREZENTACYJNY */
    .display-canvas {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 16px;
      padding: 28px 36px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow-y: auto;
    }

    /* QUIZ */
    .quiz-topic {
      font-size: 14px;
      font-weight: 800;
      color: #38bdf8;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 6px;
    }

    .quiz-question-title {
      font-size: 26px;
      font-weight: 900;
      color: #ffffff;
      line-height: 1.3;
      margin-bottom: 6px;
    }

    .quiz-question-sub {
      font-size: 16px;
      color: #94a3b8;
      margin-bottom: 24px;
    }

    .quiz-options-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      flex: 1;
      justify-content: center;
    }

    .quiz-bar-card {
      position: relative;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 16px 20px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .quiz-bar-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      background: linear-gradient(90deg, rgba(37, 99, 235, 0.4), rgba(56, 189, 248, 0.5));
      border-right: 3px solid #38bdf8;
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }

    .quiz-bar-text {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 16px;
      font-weight: 700;
      color: #f8fafc;
      max-width: 80%;
    }

    .quiz-letter-badge {
      background: #0f172a;
      border: 1px solid #475569;
      color: #38bdf8;
      font-size: 15px;
      font-weight: 900;
      padding: 4px 10px;
      border-radius: 6px;
    }

    .quiz-bar-percentage {
      position: relative;
      z-index: 2;
      font-size: 24px;
      font-weight: 900;
      color: #38bdf8;
      font-family: monospace !important;
    }

    /* Q&A GŁÓWNY */
    .qa-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .qa-headline {
      font-size: 24px;
      font-weight: 900;
      color: #ffffff;
    }
    .qa-live-badge {
      background: #064e3b;
      border: 1px solid #059669;
      color: #34d399;
      font-size: 12px;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .qa-live-badge::before {
      content: "";
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      animation: pulse-dot 1.5s infinite;
    }

    @keyframes pulse-dot {
      0% { transform: scale(0.9); opacity: 0.7; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(0.9); opacity: 0.7; }
    }

    .qa-cards-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .qa-screen-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: all 0.2s ease;
    }

    .qa-screen-text {
      font-size: 18px;
      font-weight: 700;
      color: #f8fafc;
      line-height: 1.4;
    }

    .qa-screen-votes {
      background: #0f172a;
      border: 1px solid #475569;
      color: #38bdf8;
      font-size: 16px;
      font-weight: 900;
      padding: 8px 14px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    /* FOOTER SPONSORZY */
    .screen-footer {
      height: 54px;
      background: #0a0f1d;
      border-top: 1px solid #1e293b;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 0 20px;
    }
    .sponsors-track {
      display: flex;
      align-items: center;
      gap: 50px;
      animation: marqueeScreen 30s linear infinite;
      white-space: nowrap;
    }
    @keyframes marqueeScreen {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .sponsor-item img {
      max-height: 26px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
      opacity: 0.75;
    }

    .hidden { display: none !important; }
  </style>
</head>
<body>

  <!-- 1. GÓRNY PASEK -->
  <header class="screen-header">
    <div class="brand-group">
      <img src="assets/Images/logo_konferencja_skd_2026_250x146_01.png" alt="SKD 2026" class="brand-logo-img">
      <div class="session-meta-tag">
        SALA: <strong id="header-room-name">SALA A</strong> &nbsp;|&nbsp; 
        SESJA: <strong id="header-session-name">Ostre zespoły wieńcowe u chorych z cukrzycą</strong>
      </div>
    </div>

    <!-- PRZEŁĄCZNIK WIDOKÓW -->
    <div class="mode-switch-group">
      <button id="btn-show-vote" class="btn-mode active" onclick="setScreenMode('vote')">📊 Głosowanie</button>
      <button id="btn-show-qa" class="btn-mode" onclick="setScreenMode('qa')">💬 Pytania z Sali (Q&A)</button>
    </div>
  </header>

  <!-- 2. GŁÓWNA PRZESTRZEŃ TELEBIMU -->
  <main class="screen-body">
    <!-- LEWY PANEL: QR & PIN -->
    <aside class="join-sidebar">
      <div class="join-instruction-title">Dołącz do dyskusji</div>
