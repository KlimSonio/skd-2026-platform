            <input type="email" id="edit-email" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900 focus:outline-none focus:border-slate-500 focus:bg-white" />
          </div>
        </div>

        <div>
          <label class="block font-medium text-slate-700 mb-1">Pakiety / Warsztaty</label>
          <input type="text" id="edit-packages" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900 focus:outline-none focus:border-slate-500 focus:bg-white" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-medium text-slate-700 mb-1">Status płatności</label>
            <select id="edit-payment-status" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900 focus:outline-none focus:border-slate-500">
              <option value="paid">Opłacone</option>
