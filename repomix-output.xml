<file path="index.html">
<!DOCTYPE html>
<html lang="pl" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Medical Events – Terminal Odprawy</title>
  
  <!-- Html5Qrcode -->
  <script src="https://unpkg.com/html5-qrcode"></script>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Arial', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: Arial, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, sans-serif;
    }
    #sig-canvas { touch-action: none; }
    #reader video {
      border-radius: 0.75rem;
      object-fit: cover;
      width: 100% !important;
    }
  </style>
  <script type="module" crossorigin src="/assets/main-DXSW3v1s.js"></script>
  <link rel="modulepreload" crossorigin href="/assets/modulepreload-polyfill-P2Xu9kJm.js">
</head>
<body class="bg-slate-50 text-slate-800 min-h-full flex flex-col antialiased">

  <!-- Pasek górny -->
  <header class="bg-white border-b border-slate-200 px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3 sticky top-0 z-40 shadow-xs">
    <div class="flex items-center gap-3">
      <img 
        src="/logo.png" 
        alt="Medical Events Logo" 
        class="h-8 w-auto object-contain"
        onerror="this.onerror=null; this.src='https://medicalevents.pl/wp-content/uploads/2023/04/logo-medical-events.png';" 
      />
      <div class="h-5 w-px bg-slate-200 hidden sm:block"></div>
      <div>
        <h1 class="text-sm font-bold tracking-tight text-slate-900 leading-tight">Terminal Odprawy</h1>
        <span class="text-xs text-slate-500 font-normal">Wydawanie identyfikatorów i podpis</span>
      </div>
    </div>

    <!-- Narzędzia i Wybór Operatora -->
    <div class="flex items-center gap-2">
      <button id="btn-change-operator" class="flex items-center gap-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg px-2.5 py-1.5 transition text-xs shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500">Stanowisko:</span>
        <span id="operator-display-name" class="font-bold text-slate-900">Stanowisko 1</span>
        <span class="text-slate-400 text-[10px]">▼</span>
      </button>

      <a href="/admin.html" class="text-xs font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border border-slate-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1 shadow-2xs">
        <span>Panel Admina ↗</span>
      </a>
    </div>
  </header>

  <!-- Główna zawartość -->
  <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 flex flex-col gap-4">

    <!-- SEKCJA 1: SKANER I WYSZUKIWARKA -->
    <section id="scanner-section" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h2 class="text-base font-bold text-slate-900">Skaner Biletów & Wyszukiwarka</h2>
          <p class="text-xs text-slate-500">Zeskanuj kod QR z telefonu/wydruku lub wyszukaj uczestnika</p>
        </div>
      </div>

      <!-- Okno Kamery QR -->
      <div class="relative bg-slate-900 rounded-xl overflow-hidden min-h-[240px] max-h-[300px] flex items-center justify-center">
        <div id="reader" class="w-full"></div>
        <div id="scanner-loading-placeholder" class="text-center text-slate-400 text-xs p-6 flex flex-col items-center gap-2">
          <div class="w-6 h-6 border-2 border-slate-400 border-t-white rounded-full animate-spin"></div>
          <span>Uruchamianie kamery...</span>
        </div>
      </div>

      <!-- Wyszukiwarka po tokenie / nazwisku -->
      <div class="relative flex flex-col gap-2">
        <div class="relative">
          <input 
            id="manual-token-input" 
            type="text" 
            placeholder="Szukaj po nazwisku, imieniu, PWZ lub wpisz Token..." 
            class="w-full bg-slate-50/70 border border-slate-300 rounded-xl pl-10 pr-24 py-2.5 text-xs text-slate-900 focus:outline-none focus:border-slate-500 focus:bg-white transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <button id="btn-manual-search" class="absolute right-1.5 top-1.5 bottom-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-3.5 rounded-lg transition shadow-2xs">
            Wyszukaj
          </button>
        </div>
        
        <!-- Lista podpowiedzi wyszukiwania na żywo -->
        <div id="search-suggestions" class="hidden divide-y divide-slate-100 border border-slate-200 rounded-xl max-h-48 overflow-y-auto bg-white shadow-lg text-xs"></div>
      </div>
    </section>

    <!-- SEKCJA 2: KARTA UCZESTNIKA I PODPIS -->
    <section id="attendee-card-section" class="hidden bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs flex flex-col gap-5">
      
      <!-- Nagłówek danych uczestnika -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span id="card-payment-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold"></span>
            <span id="card-attendee-token" class="font-mono text-[11px] text-slate-400 bg-slate-100 px-2 py-0.5 rounded"></span>
          </div>
          <h2 id="card-attendee-name" class="text-xl font-bold text-slate-900 leading-tight"></h2>
          <div class="flex items-center gap-3 mt-1 text-xs text-slate-600">
            <span id="card-attendee-pwz" class="font-mono font-medium"></span>
          </div>
        </div>

        <div class="flex sm:flex-col items-start sm:items-end justify-between gap-1">
          <button id="btn-open-card-edit" class="text-xs text-slate-600 hover:text-slate-900 font-semibold bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-lg border border-slate-200 transition">
            ✎ Edytuj dane
          </button>
        </div>
      </div>

      <!-- Pakiety i Warsztaty -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 flex flex-col gap-1.5">
        <span class="text-[11px] font-semibold text-slate-500">Przypisane pakiety / warsztaty:</span>
        <div id="card-packages-container" class="flex flex-wrap gap-1.5"></div>
      </div>

      <!-- Ostrzeżenie o braku płatności + przycisk szybkiego rozliczenia -->
      <div id="card-unpaid-warning" class="hidden bg-rose-50 border border-rose-200 text-rose-900 rounded-xl p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
        <div class="flex items-center gap-2">
          <span class="font-bold">⚠️ Uwaga:</span>
          <span>Brak zaksięgowanej wpłaty za udział!</span>
        </div>
        <button id="btn-mark-paid-now" class="bg-rose-600 hover:bg-rose-700 text-white font-bold px-3 py-1.5 rounded-lg transition shadow-2xs self-end sm:self-auto">
          ✓ Oznacz jako Opłacone na miejscu
        </button>
      </div>

      <!-- Cyfrowy Canvas Podpisu -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-slate-900">✍️ Podpis uczestnika (potwierdzenie odbioru):</label>
          <button id="btn-clear-sig" type="button" class="text-xs text-slate-500 hover:text-slate-800 font-semibold px-2 py-1 bg-slate-100 hover:bg-slate-200 rounded-md transition">
            Wyczyść
          </button>
        </div>

        <div class="border-2 border-dashed border-slate-300 bg-slate-50 rounded-xl relative overflow-hidden h-44">
          <canvas id="sig-canvas" class="w-full h-full cursor-crosshair"></canvas>
          <div id="sig-placeholder" class="pointer-events-none absolute inset-0 flex items-center justify-center text-xs text-slate-400 select-none">
            Złóż podpis na ekranie lub tablecie
          </div>
        </div>
      </div>

      <!-- Akcje końcowe -->
      <div class="flex items-center gap-3 pt-2">
        <button id="btn-cancel-checkin" type="button" class="w-1/3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-3 rounded-xl transition">
          Anuluj
        </button>
        <button id="btn-confirm-checkin" type="button" class="w-2/3 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-2xs">
          <span>✓ Wydaj Identyfikator</span>
        </button>
      </div>

    </section>

  </main>

  <!-- MODAL: Wybór Stanowiska / Operatora -->
  <div id="operator-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-sm w-full p-5 shadow-xl flex flex-col gap-4 my-auto">
      <div class="border-b border-slate-100 pb-2">
        <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Konfiguracja terminala</span>
        <h3 class="font-bold text-slate-900 text-base">Wybierz Stanowisko</h3>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-700 mb-1">Operator / Stanowisko recepcji:</label>
        <select id="select-operator-dropdown" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-2 text-xs text-slate-900 focus:outline-none focus:border-slate-500"></select>
      </div>
      <div class="flex gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-operator" class="w-1/3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2 rounded-lg text-xs transition">Anuluj</button>
        <button id="btn-save-operator" class="w-2/3 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2 rounded-lg text-xs transition shadow-2xs">Zapisz wybór</button>
      </div>
    </div>
  </div>

  <!-- MODAL: Szybka edycja danych na recepcji -->
  <div id="card-edit-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-5 shadow-xl flex flex-col gap-4 my-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <div>
          <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Korekta recepcji</span>
          <h3 class="font-bold text-slate-900 text-base">Szybka edycja uczestnika</h3>
        </div>
        <button id="btn-close-card-edit" class="text-slate-400 hover:text-slate-700 text-base font-bold">✕</button>
      </div>

      <form id="card-edit-form" class="flex flex-col gap-3 text-xs">
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block font-medium text-slate-700 mb-1">Tytuł</label>
            <input type="text" id="quick-academic-title" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900" />
          </div>
          <div>
            <label class="block font-medium text-slate-700 mb-1">Imię *</label>
            <input type="text" id="quick-first-name" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900" />
          </div>
          <div>
            <label class="block font-medium text-slate-700 mb-1">Nazwisko *</label>
            <input type="text" id="quick-last-name" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-medium text-slate-700 mb-1">Numer PWZ</label>
            <input type="text" id="quick-pwz" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 font-mono text-slate-900" />
          </div>
          <div>
            <label class="block font-medium text-slate-700 mb-1">Status płatności</label>
            <select id="quick-payment-status" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900">
              <option value="paid">Opłacone</option>
              <option value="exempt">Zwolniony / VIP</option>
              <option value="unpaid">Nieopłacone</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-medium text-slate-700 mb-1">Pakiety / Warsztaty (po przecinku)</label>
          <input type="text" id="quick-packages" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-900" />
        </div>

        <div class="flex gap-2 pt-2 border-t border-slate-100">
          <button type="button" id="btn-cancel-card-edit" class="w-1/3 bg-slate-100 text-slate-700 font-semibold py-2 rounded-lg transition">Anuluj</button>
          <button type="submit" id="btn-save-card-edit" class="w-2/3 bg-slate-900 text-white font-semibold py-2 rounded-lg shadow-2xs transition">✓ Zapisz</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Custom Alert -->
  <div id="custom-alert-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-xs w-full p-5 shadow-xl flex flex-col items-center text-center gap-3 my-auto">
      <div id="alert-icon" class="w-10 h-10 rounded-full bg-sky-100 text-sky-800 flex items-center justify-center text-base font-bold">ℹ️</div>
      <h3 id="alert-title" class="font-bold text-slate-900 text-sm">Informacja</h3>
      <p id="alert-message" class="text-xs text-slate-600"></p>
      <button id="btn-close-alert" class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2 rounded-lg transition mt-1 shadow-2xs">
        OK
      </button>
    </div>
  </div>

  <!-- MODAL: Custom Confirm -->
  <div id="custom-confirm-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-2xs z-50 flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl max-w-xs w-full p-5 shadow-xl flex flex-col items-center text-center gap-3 my-auto">
      <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-base font-bold">⚠️</div>
      <h3 id="confirm-title" class="font-bold text-slate-900 text-sm">Potwierdzenie</h3>
      <p id="confirm-message" class="text-xs text-slate-600"></p>
      <div class="flex gap-2 w-full mt-1">
        <button id="btn-confirm-no" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2 rounded-lg transition">Nie</button>
        <button id="btn-confirm-yes" class="w-1/2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2 rounded-lg transition shadow-2xs">Tak</button>
      </div>
    </div>
  </div>

</body>
</html>
