<file path="admin.html">
<!DOCTYPE html>
<html lang="pl" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Medical Events – Panel Administratora</title>
  
  <!-- QRCode.js -->
