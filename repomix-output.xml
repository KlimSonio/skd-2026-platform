<!DOCTYPE html>
<html lang="pl" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Medical Events – Terminal Odprawy</title>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, sans-serif; }
    #sig-canvas { touch-action: none; }
    #reader video { border-radius: 0.75rem; object-fit: cover; width: 100% !important; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-full flex flex-col antialiased select-none">

  <!-- EKRAN BLOKADY: KLAWIATURA PIN -->
  <div id="pin-lock-screen" class="fixed inset-0 bg-slate-900 z-50 flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-xs w-full p-6 sm:p-7 shadow-2xl flex flex-col items-center text-center gap-5 my-auto">
      <div>
        <div class="w-12 h-12 bg-slate-100 text-slate-900 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-2 font-bold shadow-inner">🔒</div>
        <h2 class="text-base font-bold text-slate-900">Stanowisko Recepcji</h2>
        <p class="text-xs text-slate-500 mt-0.5">Wpisz 4-cyfrowy PIN stanowiska</p>
      </div>

      <div id="pin-dots-container" class="flex items-center justify-center gap-3 py-2">
        <div id="pin-dot-1" class="w-4 h-4 rounded-full border-2 border-slate-300"></div>
        <div id="pin-dot-2" class="w-4 h-4 rounded-full border-2 border-slate-300"></div>
        <div id="pin-dot-3" class="w-4 h-4 rounded-full border-2 border-slate-300"></div>
        <div id="pin-dot-4" class="w-4 h-4 rounded-full border-2 border-slate-300"></div>
      </div>

      <div id="pin-error-msg" class="hidden text-xs font-bold text-rose-600 bg-rose-50 px-3 py-1 rounded-lg border border-rose-200">
        Nieprawidłowy kod PIN!
      </div>

      <div class="grid grid-cols-3 gap-2.5 w-full max-w-[220px]">
        <button class="pin-key h-12 rounded-xl bg-slate-50 hover:bg-slate-200 text-slate-900 text-lg font-bold transition border border-slate-200" data-val="1">1</button>
