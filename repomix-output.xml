      <div class="pt-2.5 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 mb-1">Pakiet / Warsztat</label>
          <select id="filter-package" class="w-full bg-slate-50/70 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:border-slate-500"></select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 mb-1">Kryterium PWZ</label>
